# install
  yum install postgresql-server # rather https://computingforgeeks.com/how-to-install-postgresql-on-fedora/
  # also
  # postgis https://computingforgeeks.com/how-to-install-postgis-on-centos-7/
  # pgadmin https://computingforgeeks.com/how-to-install-pgadmin-on-centos-fedora/

# postinstall
  sudo postgresql-setup --initdb --unit postgresql
  sudo systemctl enable postgresql.service
  sudo systemctl start postgresql.service

# create accounts
sudo -u postgres psql
postgres=# create role name createrole createdb replication login password 'pwd';


# create user and database
sudo -i -u postgres
createuser username
creatdb db-name -O username
psql -d db-name

# enable postgis
=# CREATE EXTENSION postgis;
# verify
=# select PostGIS_version();

# allowing connections
=# show hba_file; (find path e.g. /var/lib/pgsql/data/pg_hba.conf)
# to trust local connection modify to 
local	all	all	trust
host	all	127.0.0.1/32	trust
# then restart service
systemctl restart postgresql.service
