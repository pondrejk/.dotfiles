last login attempts:
  /var/log/wtmp – Logs of last login sessions
  /var/run/utmp – Logs of the current login sessions
  /var/log/btmp – Logs of the bad login attempts
also:
  /var/log/secure
  /var/log/faillog

# pcp
yum install -y pcp
systemctl enable --now pmcd
systemctl enable --now pmlogger # logs to /var/log/pcp/pmlogger/<hostname>
pmstat -s 5            # like vmstat but interactive
pminfo                 # list stored metrics, -d for description, -a to list from archive
pmval -s 5 <metric>    # gather real-time data on metric
pmval -a logger.data <metric>  # inspect pmlogger output
pmval -i "'1 minute','5 minute'" kernel.all.load # intervals
pmval -S -T # starttime, endtime, syntax man PCPIntro

pmlogsummary -HlfiImM <metric> # min, max, mintime, maxtime


