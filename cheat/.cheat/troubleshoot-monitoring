# pcp
yum install -y pcp
systemctl enable --now pmcd
systemctl enable --now pmlogger # logs to /var/log/pcp/pmlogger/<hostname>
pmstat -s 5            # like vmstat but interactive
pminfo                 # list stored metrics, -d for description, -a to list from archive
pmval -s 5 <metric>    # gather real-time data on metric
pmval -a logger.data <metric>  # inspect pmlogger output
# TODO time filtering for pmval, max cpu?

# aide - manual check for time changes
config what to track in /etc/aide.conf
aide --init    # create a database (store it outside of a system)
aide --check   # check the current state against the db

# auditctl (systemctl start uditd)
create a wathch rule
auditctl -w <path/to/target> -p rwax -k custom-tag # watch rw, execute, attr. change
auditctl -l   # list rules
to make persistant add add rules to '/etc/audit/rules.d/filename'
logs end up in '/var/log/audit/audit.log'
tool to search the log ^
ausearch -i -k key   # i interprets the numerical values
