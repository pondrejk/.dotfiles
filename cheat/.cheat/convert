# To resize an image to a fixed width and proportional height:
convert original-image.jpg -resize 100x converted-image.jpg

# To resize an image to a fixed height and proportional width:
convert original-image.jpg -resize x100 converted-image.jpg

# To resize an image to a fixed width and height:
convert original-image.jpg -resize 100x100 converted-image.jpg

# To resize an image and simultaneously change its file type:
convert original-image.jpg -resize 100x converted-image.png

# To crop 20px from the bottom of the picture 
convert original.jpg -crop +0-20 bottom_cropped.jpg # doesn't preserve transparency
convert image.png -gravity South -chop 0x20 result.png # preserves trnasp

# To resize all of the images within a directory:
# To implement a for loop:
for file in `ls original/image/path/`;
    do new_path=${file%.*};
    new_file=`basename $new_path`;
    convert $file -resize 150 conerted/image/path/$new_file.png;
done
