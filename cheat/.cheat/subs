# register & subscribe
subscription-manager register --force --user --password --release
subscription-manager subscribe --pool

# reg to sat
subscription-manager register --org --activationkey

# clean when trouble
subscription-manager clean

# repos
subscription-manager repos --enable / --disable

# get consumed pool
subscription-manager list --pool-only --consumed

# check certs
rct cat-cert /etc/pki/product-default/230.pem
