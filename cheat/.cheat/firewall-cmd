# add port example
firewall-cmd --permanent --add-port=3260/tcp [--zone=zone | oterwise default]
firewall-cmd --reload

# add service example
firewall-cmd --permanent --add-service=mysql [--zone=zone | oterwise default]
firewall-cmd --reload

# listing
firewall-cmd --list-all-zones
firewall-cmd --list-rich-rules

# masquerading
firewall-cmd --permanent --zone=<zone> --add-masquerade # any packets
firewall-cmd --permanent --zone=<zone> --add-rich-rule='rule family=ipv4 source address=<ip>/<mask> masquerade'

# port forwarding
firewall-cmd --permanent --zone=<zone> --add-rich-rule='rule family=ipv4 source address=<ip>/<mask> forward-port port="<port>" protocol=tcp to-port"<port>"'

# add port labels so that SELinux allows services to listen on ports
# -- list ports
semanage port -l

# -- add port for service
semanage port -a -t <port_label> (e.g. gofer_port_t) -p tcp|udp <portnumber>
