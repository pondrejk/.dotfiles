# see also https://devhints.io/sass
# Variables

$red: #833;

body {
  color: $red;
}

#Nesting

.markdown-body {
  p {
    color: blue;
  }

  &:hover {
    color: red;
  }
}

#Mixins

@mixin heading-font {
  font-family: sans-serif;
  font-weight: bold;
}

h1 {
  @include heading-font;
}

# Mixin properties

@mixin font-size($n) {
  font-size: $n * 1.2em;
}

body {
  @include font-size(2);
}

