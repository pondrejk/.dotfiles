# adding and syncing remotes
git remote -v
git remote add <remote_name> <git_url>
git pull --rebase <remote_name> <remote_branch>

# rename branch
git branch -m old_branch_name new_branch_name

# create a branch tracking new remote branch
git fetch upstream 6.3.z
git branch --track 6.3.z upstream/6.3.z

# revert a commit in a single file
git checkout <commit_id> <file/to/restore>
git checkout -p <commit_id> <file/to/restore> # interactive

# search in the history of changes
git log -S string     # shows commits that handled string
git log -S string -p  # shows diffs
git log -G regex      # commits matching regex

# reset last commit (before pushing)
git reset HEAD~
git reset --soft HEAD~  # leaves changes staged

# revert last commit (after pushing)
git revert <commit>     # adds another commit

# apply patch from github commit (in a correct location)
curl https://github.com/<commit>.patch | git apply # add --exclude <file> if needed 

# revert patch
git apply -R <patch>

# recover from unwanted amend
git reset --soft HEAD@{1}
git commit -C HEAD@{1}

# squashing commits
git rebase -i HEAD~4
-- in editor keep first commit, squash others

# tagging
git tag # list
git tag -a 0.2 -m "version desc" # tags the latest commit
git tag -a v1.2 9fceb02 # tags previous commit
git show 0.2 / git checkout 0.2
