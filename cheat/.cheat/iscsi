# iscsi
# on server
- install targetd, targetcli; start target service (not to confuse with targetd!), allow 3260/tcp in firewall
- in /etc/iscsi/initiatorname.iscsi set the initiator (recipient) name
- in targetcli:
-- /blockstores/block create -- name + partition
-- /iscsi create -- diskname, e.g. iqn.2014-06.com.example:server5.zoidberg
-- /iscsi/.../acls create -- initator name
-- /iscsi/.../portals create -- ip addr
-- /iscsi/.../luns create -- /blockstores device
-- saveconfig

# on client
- install iscsi-initiator-utils
- in **/etc/iscsi/initiatorname.iscsi** add client name
- start iscsi and iscsid service (both need to run and be enabled)
- discover target:
iscsiadm -m discovery -t st -p 172.25.5.11 # portal set on server

- log in to the target (should appear in lsblk afterwards)
iscsiadm -m node -T iqn.2014-06.com.example:serverX -p 172.25.5.11 -l

- check status 
iscsiadm -m session -P 3 # verbosity level

- optionally create a filesystem and mount the share
sudo mkfs -t xfs /dev/sda
sudo mkdir /iscsidisk
- add to /etc/fstab
blkid  /dev/sda # get uuid
UUID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX /iscsidisk xfs _netdev 0 0
mount /iscsidisk

