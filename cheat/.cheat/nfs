# nfs
# on server

- start nfs-server service
- create share dir, set ownership
- in /etc/exports add line:
/exp_dir client-hostname(rw) # here can also be a subnet instead of hostname, e.g. 192.168.100.22/24(rw)
- exportfs -r  # to load exports file
- firewall-cmd --permanent --add-service=nfs
- firewall-cmd --reload

# on client

- create mount point, e.g. /mnt/nfsshare
- add to /etc/fstab
server5:/nfsshare   /mnt/nfsshare      nfs     defaults        0 0
- mount -a  # to verify


# nfs secure with selinux export
# on server

- have keytab prepared in /etc/krb5.keytab
- start nfs-secure-server service
- in /etc/sysconfig/nfs set:
RPCNFSDARGS="-V 4.2" # needed to export selinux labels
- create share dir
- in /etc/exports add line:
/exp_dir client-hostname(sec=krb5p,rw)
- exportfs -r  # to load exports file
- firewall-cmd --permanent --add-service=nfs
- firewall-cmd --reload

- when creating a file in a shared dir, set content
chcon -t public_content_t /exp_dir/file.txt

# on client
- start nfs-secure service
- have keytab prepared in /etc/krb5.keytab
- create mount point, e.g. /mnt/secureshare
- add to /etc/fstab
server5:/securenfs   /mnt/secureshare      nfs     defaults,v4.2,sec=krb5p        0 0
- mount -a  # to verify

- note the user has to be authenticated via kerberos to see the content of shared dir
