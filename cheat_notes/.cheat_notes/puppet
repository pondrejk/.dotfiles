# puppet 3
# viewing resources
puppet resource --type
puppet resource package httpd

# applying manifests locally
puppet apply manifest.pp

# checking syntax and dryrun
puppet parser validate manifest.pp
puppet apply --noop manifest.pp

# checking system facts, referencing them in manifests, e.g.:
facter | grep os
facter osfamily
# to those facts in manifests:
$::osfamily
${::identity['user']}

# add custom facts to /etc/facter/facts.d/ (can be txt, yml, json, shell script)
# check with facter --debug
# needs to have form of key=value, e.g. for script:
echo 'root_disk_use=$(df --output=pcent / | sed 1d)' 

# create module skeleton
puppet module generate <author-modulename>
# build -- creates an archive from the module workdir
puppet module build <author-modulename>
# install -- installs the build module on the sys
puppet module install <author-modulename>/pkg/...tar.gz

# external modules
puppet module search motd | grep @puppetlabs
puppet module install puppetlabs-motd --modulepath=. #modulepath installs to the current dir
# -f option forces to uses local path if not clear from the name, also overwrites if module is already installed

# regexes in conditionals -- enclose in // and use =~
if $::ipaddress =~ /172\.25\.250\.1[01]/ # for .10 of .11

# sourcing file resources (alternative to content =>)
source => 'puppet:///modules/<modulename>/<filename>' # file needs to be at the same level as manifests dir in module
content => template('<modulename>/<filename>.erb')

# for puppet4, executables are moved to /opt/puppetlabs/bin/ that is not added to PATH bz default:
PATH=$PATH:/opt/puppetlabs/bin/

