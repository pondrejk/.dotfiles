# Establishing a Secure Connection for Remote Commands
on client run:

curl https://myproxy.example.com:9090/ssh/pubkey >> ~/.ssh/authorized_keys

# btw, to setup sat to run jobs against self:
curl https://`hostname`:9090/ssh/pubkey >> ~/.ssh/authorized_keys

or distribute from server:

ssh-copy-id -i ~foreman-proxy/.ssh/id_rsa_foreman_proxy.pub root@target.example.com

# debug logging
set:
ssh_log_level: debug
in /etc/foreman-proxy/settings.d/remote_execution_ssh.yml

and  
:log_level: DEBUG
in /etc/foreman-proxy/settings.yml (prev. in /etc/smart_proxy_dynflow_core/settings.yml)

systemctl restart foreman-proxy
and observe
/var/log/foreman-proxy/proxy.log

on client you can do
journalctl -fl

to work around BZ#1656480
sed -i '/ProxyCommand/s/^/#/g' /etc/ssh/ssh_config

# todo using alternate ssh cyphers

# force execution through the registered trough capsule
use setting "Prefer registered through Capsule for remote execution" under content

# see host to capsule mapping in for job invocations
foreman=# select * from host_proxy_invocations;

# check smart proxy memory consumption
top -p `pgrep "smart-proxy"`
