[global_config]
  borderless = True
  always_on_top = True
  sticky = True
  inactive_color_offset = 1.0
  enabled_plugins = APTURLHandler, LaunchpadCodeURLHandler, LaunchpadBugURLHandler
  ask_before_closing = never
[keybindings]
  go_up = <Alt>k
  go_down = <Alt>j
  go_left = <Alt>h
  go_right = <Alt>l
  split_horiz = <Primary>h
  split_vert = <Primary>s
  close_term = <Alt>c
  full_screen = F10
  hide_window = F12
  layout_launcher = <Alt>o
